/archives/
/highD_dataset/
/references/
/HighwayEnv/
/ref_code/

# Current files above the common GitHub hard limit of 100 MiB per file.
# Keep these ignored so `git add .` can include as much repository content as
# possible without adding files that a normal remote push will reject.
/results/diffusion_natural/following/dataset.npz
/results/highd_events/following_event_segments.npz

