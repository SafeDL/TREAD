# ============================================================
# TREAD 项目 .gitignore
# ============================================================

# ── highD 原始数据和 Matlab 产物 ─────────────────────────
highD_dataset/Matlab/data/
highD_dataset/Matlab/data/.~lock.*
highD_dataset/Matlab/bin/*.mat
highD_dataset/Matlab/测试数据及处理算法/
highD_dataset/Matlab/visualization/*.fig

# ── Matlab / Excel / Simulink 二进制文件 ────────────────
*.fig
*.xls
*.xlsx
*.slx

# ── Python 缓存、构建和测试产物 ─────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/

# ── 虚拟环境 ────────────────────────────────────────────
venv/
.venv/
env/

# ── 训练日志和实验追踪 ─────────────────────────────────
wandb/
lightning_logs/
**/events.out.tfevents.*
*.tfevents*
*.log

# ── 大型二进制、媒体和模型产物 ─────────────────────────
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.hdf5
*.joblib
*.pkl
*.npy
*.npz
*.parquet
*.mp4
*.avi
*.mov
*.mkv
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
**/checkpoints/
**/ckpt/
**/model_checkpoints/
**/.plot_cache/

# ── TREAD 当前结果目录 ─────────────────────────────────
# 只忽略大型数组、模型、逐样本轨迹、逐样本大表、事件全集和可再生成媒体。
# 小型 summary JSON、schema、split、normalization stats、聚合 metrics CSV、
# top-cases JSON 和 PNG 诊断图默认可提交。
/results/**/checkpoints/
/results/**/ckpt/
/results/**/.plot_cache/
/results/**/*.pt
/results/**/*.pth
/results/**/*.ckpt
/results/**/*.onnx
/results/**/*.npy
/results/**/*.npz
/results/**/*dataset*.npz
/results/**/*.h5
/results/**/*.hdf5
/results/**/*.parquet
/results/**/*.pkl
/results/**/*.joblib
/results/**/*.log
/results/**/*.tfevents*
/results/**/events.out.tfevents.*
/results/**/*.mp4
/results/**/*.avi
/results/**/*.mov
/results/**/*.mkv

# 可再生成的大型事件表、context 数组和逐样本产物。
/results/highd_events/events.csv
/results/highd_events/candidate_events.csv
/results/highd_events/invalid_events.csv
/results/highd_tail_contexts/**/tail_contexts.npz
/results/highd_tail_contexts/**/tail_scores.npz
/results/**/context_tail_scores.csv
/results/adversaray/**/*samples.npz
/results/adversaray/**/*traces.npz
/results/adversaray/**/risk_tilted_*
/results/subset_simulation/tail_contexts.npz
/results/subset_simulation/*samples.npz
/results/subset_simulation/*tail_scores.npz
/results/subset_simulation/subset_tail_scores.csv

# 旧版 data/ 输出目录保留为本地实验产物，不再作为主线提交。
/data/highd_events/
/data/diffusion_natural/
/data/adversaray/
/data/subset_simulation/

# ── 项目外部材料和临时输出 ─────────────────────────────
/references/
/outputs/
/tmp/
/temp/

# ── IDE / 编辑器 / 系统文件 ────────────────────────────
.idea/
.vscode/
.agents/
.claude/
.codex/
*.swp
*.swo
*~
.ipynb_checkpoints/
Thumbs.db
.DS_Store
