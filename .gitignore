# ============================================================
# TREAD Project .gitignore
# ============================================================

# ── highD 原始数据和 Matlab 产物 ─────────────────────────
highD_dataset/Matlab/data/
highD_dataset/Matlab/data/.~lock.*
highD_dataset/Matlab/bin/*.mat
highD_dataset/Matlab/测试数据及处理算法/
highD_dataset/Matlab/visualization/*.fig

# ── Matlab / Excel / Simulink 二进制文件 ────────────────
*.fig
*.xls
*.xlsx
*.slx

# ── 大型二进制/媒体/模型产物 ───────────────────────────
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.hdf5
*.joblib
*.mp4
*.avi
*.mov
*.mkv
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
**/model_checkpoints/

# ── TREAD 数据、论文材料和实验输出 ──────────────────────
/references/
/outputs/
/results/
/wandb/
/lightning_logs/

# data/ 下允许提交小型 CSV/JSON/schema 等元数据；只忽略大型或可再生成产物。
/data/**/checkpoints/
/data/**/ckpt/
/data/**/.plot_cache/
/data/**/*.pt
/data/**/*.pth
/data/**/*.ckpt
/data/**/*.onnx
/data/**/*.npy
/data/**/*.npz
/data/**/*dataset*.npz
/data/**/*.h5
/data/**/*.hdf5
/data/**/*.parquet
/data/**/*.pkl
/data/**/*.joblib
/data/**/*.log
/data/**/*.tfevents*
/data/**/events.out.tfevents.*

# 大型事件表和逐样本分数表可再生成，提交摘要文件即可。
/data/highd_events/events.csv
/data/highd_events/candidate_events.csv
/data/**/context_tail_scores.csv

# adversaray 下的判别器/引导采样大数据可再生成，继续忽略；
# 但 schema、stats、summary、metrics、图表和简短测试结果允许提交。
/data/adversaray/**/checkpoints/
/data/adversaray/**/ckpt/
/data/adversaray/**/.plot_cache/
/data/adversaray/**/*.pt
/data/adversaray/**/*.pth
/data/adversaray/**/*.ckpt
/data/adversaray/**/*.onnx
/data/adversaray/**/*.npy
/data/adversaray/**/*.npz
/data/adversaray/**/*.h5
/data/adversaray/**/*.hdf5
/data/adversaray/**/*.parquet
/data/adversaray/**/*.pkl
/data/adversaray/**/*.joblib
/data/adversaray/**/*.log
/data/adversaray/**/*.tfevents*
/data/adversaray/**/events.out.tfevents.*
!/data/adversaray/**/*.json
!/data/adversaray/**/*.csv
/data/adversaray/following/prior_guided/context_tail_scores.csv
!/data/adversaray/**/*.md
!/data/adversaray/**/*.txt
!/data/adversaray/**/*.yaml
!/data/adversaray/**/*.yml
!/data/adversaray/**/*.png
!/data/adversaray/**/*.jpg
!/data/adversaray/**/*.jpeg
!/data/adversaray/**/*.svg


# ── Python 通用 ─────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.tox/
.coverage
htmlcov/

