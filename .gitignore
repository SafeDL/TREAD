# Regenerable TREAD result tables.
# Keep JSON summaries, schemas, split files, and PNG diagnostics visible by
# default; ignore large arrays, checkpoints, media, logs, and bulky CSV tables.
/results/highd_events/events.csv
/results/highd_events/candidate_events.csv
/results/highd_events/*event_scores.csv
/results/highd_events/exposure_per_recording.csv
/results/**/highd_independent_tail_peaks.csv
/results/**/context_tail_scores.csv
/results/**/tail_scores.csv
/results/**/latent_subset_level_stats.csv
/results/**/subset_tail_scores.csv
/results/**/*samples.csv
/results/**/*samples.npz
/results/**/*traces.npz
/results/**/risk_tilted_*

# Curated final-level playback artifacts are small enough to review and useful
# for reproducing the discovered subset failures. Bulk generated playback GIFs
# remain ignored by the global media rules above.
!/results/subset_simulation_*/figures/final_level_playbacks/
!/results/subset_simulation_*/figures/final_level_playbacks/*.json
!/results/subset_simulation_*/figures/final_level_playbacks/*.png
!/results/subset_simulation_*/figures/final_level_playbacks/*.gif

# Legacy local experiment outputs
/data/highd_events/
/data/diffusion_natural/
/data/subset_simulation/

