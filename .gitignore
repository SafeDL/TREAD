**/checkpoints/
**/ckpt/
**/.plot_cache/

# ── 虚拟环境 ────────────────────────────────────────────
venv/
.venv/
env/

# ── IDE ─────────────────────────────────────────────────
.idea/
.vscode/
.agents/
.claude/
.codex/
*.swp
*.swo
*~

# ── Jupyter ─────────────────────────────────────────────
.ipynb_checkpoints/

